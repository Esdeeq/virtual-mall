# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ── Chain ──────────────────────────────────────────────────────────────────
# Set to true for Arc Mainnet, leave empty or false for Arc Testnet
VITE_ARC_MAINNET=true

# ── Escrow contract ────────────────────────────────────────────────────────
# Deployed MallEscrow contract address
VITE_ESCROW_ADDRESS=0x...

# Private key of the escrow signer (authorises deposits, never holds funds)
# Generate with: cast wallet new
VITE_ESCROW_SIGNER_KEY=0x...

# ── Merchant ───────────────────────────────────────────────────────────────
# Wallet address that receives USDC after buyer confirms order received
VITE_MERCHANT_ADDRESS=0x...
SELLER_ADDRESS=0x...

# ── Circle ─────────────────────────────────────────────────────────────────
# Standard Developer API Key from Circle Console
CIRCLE_API_KEY=

# Circle App ID for user-controlled wallets (PIN/email sign-in)
VITE_CIRCLE_APP_ID=

# ── Server agent wallet ────────────────────────────────────────────────────
# Private key for the server-side mall agent wallet (/api/agent/pay)
AGENT_PRIVATE_KEY=0x...
